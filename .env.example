# Optional — leave blank for local development (uses ./outputs/)
# On Render with a persistent disk, set to the mount path, e.g.:
# STORAGE_PATH=/opt/render/project/data

STORAGE_PATH=

# Persistence / identity (prototype defaults already match these)
# DATABASE_URL=                         # omit = SQLite at outputs/farmbiddy.db
# PERSISTENCE_BACKEND=db                # json = rollback to file stores
# IDENTITY_PROVIDER=dev
# FARMBIDDY_SEED_DEMO=1                 # seed extra demo records on startup

# Dairy statement provider integration — placeholders only, not read by any
# code yet. The mock flow (services/dairy_statement_provider_factory.py)
# does not require these. They document the variables a future real
# HttpDairyStatementProvider integration would use; see
# docs/dairy_statement_integration.md. Leave commented out / blank.
# DAIRY_STATEMENT_PROVIDER_MODE=mock
# DAIRY_STATEMENT_API_BASE_URL=
# DAIRY_STATEMENT_API_KEY=
